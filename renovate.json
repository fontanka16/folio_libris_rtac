{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Stockholm",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Pinna + uppdatera Docker-images till immutable digests (supply-chain). Grupperas i en PR.",
      "matchManagers": ["docker-compose", "dockerfile"],
      "groupName": "Docker images",
      "automerge": false
    },
    {
      "description": "Gruppera alla Python-beroenden i en PR",
      "matchManagers": ["pip_requirements", "pep621"],
      "groupName": "Python dependencies",
      "automerge": false
    }
  ]
}
