# Add any directories, files, or patterns you don't want to be tracked by version control
static/node_modules/
.env
.vscode/
static/package-lock.json

# Python / uv
.venv/
__pycache__/
*.pyc

# Per-library settings (contain FOLIO credentials). Ignore everything under
# libraries/ so a stray credential file can't be committed by accident; the
# per-sigel dirs (libraries/<sigel>/settings.json) stay ignored. Explicitly
# allow the non-secret tracked files (template, README, permission list).
libraries/*
!libraries/README.md
!libraries/example.settings.json
!libraries/folio-permissions.json